# Copy this file to .env and fill values (do NOT commit .env to source control)
# Example Firebase config as a JSON string. Replace with your real values.
VITE_FIREBASE_CONFIG='{"apiKey":"YOUR_API_KEY","authDomain":"YOUR_AUTH_DOMAIN","projectId":"YOUR_PROJECT_ID","storageBucket":"YOUR_STORAGE_BUCKET","messagingSenderId":"YOUR_SENDER_ID","appId":"YOUR_APP_ID"}'

# Optional app ID used in the original code
VITE_APP_ID=priya-electrical-v2

# Optional: initial auth token for custom sign-in
VITE_INITIAL_AUTH_TOKEN=
